## Basys3 constraints for voice_top (Rev3.2 SCL SAR ADC voice front end)
## Pmod JA = ADC DOUT[7:0] (through a 74LVC245 at 3.3 V: the ADC outputs are 5 V)
## Pmod JB1 = EOC, JB2 = DVALID (same buffer); JB3 = ADC CLK, JB4 = ADC RST_N (through a 74HCT buffer at 5 V); JB8 = UART to ESP32-S3 RX
set_property -dict {PACKAGE_PIN W5  IOSTANDARD LVCMOS33} [get_ports clk]
create_clock -period 10.000 -name sys_clk [get_ports clk]
set_property -dict {PACKAGE_PIN U18 IOSTANDARD LVCMOS33} [get_ports btnC]
set_property -dict {PACKAGE_PIN A18 IOSTANDARD LVCMOS33} [get_ports uart_tx]
set_property -dict {PACKAGE_PIN J1  IOSTANDARD LVCMOS33} [get_ports {adc_dout[0]}]
set_property -dict {PACKAGE_PIN L2  IOSTANDARD LVCMOS33} [get_ports {adc_dout[1]}]
set_property -dict {PACKAGE_PIN J2  IOSTANDARD LVCMOS33} [get_ports {adc_dout[2]}]
set_property -dict {PACKAGE_PIN G2  IOSTANDARD LVCMOS33} [get_ports {adc_dout[3]}]
set_property -dict {PACKAGE_PIN H1  IOSTANDARD LVCMOS33} [get_ports {adc_dout[4]}]
set_property -dict {PACKAGE_PIN K2  IOSTANDARD LVCMOS33} [get_ports {adc_dout[5]}]
set_property -dict {PACKAGE_PIN H2  IOSTANDARD LVCMOS33} [get_ports {adc_dout[6]}]
set_property -dict {PACKAGE_PIN G3  IOSTANDARD LVCMOS33} [get_ports {adc_dout[7]}]
set_property -dict {PACKAGE_PIN A14 IOSTANDARD LVCMOS33} [get_ports adc_eoc]
set_property -dict {PACKAGE_PIN A16 IOSTANDARD LVCMOS33} [get_ports adc_dvalid]
set_property -dict {PACKAGE_PIN B15 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 12} [get_ports adc_clk]
set_property -dict {PACKAGE_PIN B16 IOSTANDARD LVCMOS33} [get_ports adc_rst_n]
set_property -dict {PACKAGE_PIN C16 IOSTANDARD LVCMOS33} [get_ports uart_esp]
## LEDs: [15:8] last ADC code, [2] DVALID, [1] output heartbeat, [0] ADC out of reset
set_property -dict {PACKAGE_PIN U16 IOSTANDARD LVCMOS33} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN E19 IOSTANDARD LVCMOS33} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN U19 IOSTANDARD LVCMOS33} [get_ports {led[2]}]
set_property -dict {PACKAGE_PIN V19 IOSTANDARD LVCMOS33} [get_ports {led[3]}]
set_property -dict {PACKAGE_PIN W18 IOSTANDARD LVCMOS33} [get_ports {led[4]}]
set_property -dict {PACKAGE_PIN U15 IOSTANDARD LVCMOS33} [get_ports {led[5]}]
set_property -dict {PACKAGE_PIN U14 IOSTANDARD LVCMOS33} [get_ports {led[6]}]
set_property -dict {PACKAGE_PIN V14 IOSTANDARD LVCMOS33} [get_ports {led[7]}]
set_property -dict {PACKAGE_PIN V13 IOSTANDARD LVCMOS33} [get_ports {led[8]}]
set_property -dict {PACKAGE_PIN V3  IOSTANDARD LVCMOS33} [get_ports {led[9]}]
set_property -dict {PACKAGE_PIN W3  IOSTANDARD LVCMOS33} [get_ports {led[10]}]
set_property -dict {PACKAGE_PIN U3  IOSTANDARD LVCMOS33} [get_ports {led[11]}]
set_property -dict {PACKAGE_PIN P3  IOSTANDARD LVCMOS33} [get_ports {led[12]}]
set_property -dict {PACKAGE_PIN N3  IOSTANDARD LVCMOS33} [get_ports {led[13]}]
set_property -dict {PACKAGE_PIN P1  IOSTANDARD LVCMOS33} [get_ports {led[14]}]
set_property -dict {PACKAGE_PIN L1  IOSTANDARD LVCMOS33} [get_ports {led[15]}]
## ADC inputs are asynchronous to sys_clk (EOC is synchronised, DOUT is sampled 150 ns after EOC while stable)
set_false_path -from [get_ports {adc_dout[*] adc_eoc adc_dvalid}]
